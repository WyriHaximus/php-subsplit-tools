{
  "name": "wyrihaximus/subsplit-tools",
  "description": "Tools to do initial code generation for sub split set up",
  "license": "MIT",
  "authors": [
    {
      "name": "Cees-Jan Kiewiet",
      "email": "ceesjank@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "api-clients/github": "^0.2@dev",
    "api-clients/openapi-client-utils": "dev-main",
    "devizzent/cebe-php-openapi": "^1.1.5",
    "react/http": "^1.11.0",
    "wyrihaximus/simple-twig": "^2.4.0"
  },
  "require-dev": {
    "wyrihaximus/makefiles": "^0.14.7",
    "wyrihaximus/test-utilities": "^14.2.0"
  },
  "autoload": {
    "psr-4": {
      "WyriHaximus\\SubSplitTools\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WyriHaximus\\Tests\\SubSplitTools\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true,
      "wyrihaximus/makefiles": true,
      "wyrihaximus/test-utilities": true
    },
    "platform": {
      "php": "8.4.13"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "make on-install-or-update || true"
    ],
    "post-update-cmd": [
      "make on-install-or-update || true"
    ]
  }
}
